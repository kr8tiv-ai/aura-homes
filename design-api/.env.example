# All optional. The service runs with none of them set — it falls back to the
# deterministic planner and returns a blueprint without renders.

# --- reasoning (pick one) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- imagery (pick one) ---
IMAGE_PROVIDER=replicate
# Apache-2.0 weights. flux-dev is NON-COMMERCIAL — do not ship it.
IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_API_TOKEN=
FAL_KEY=
MAX_RENDERS=2

OUT_DIR=out
CORS_ORIGINS=http://localhost:3000,https://aurahomes.fun
